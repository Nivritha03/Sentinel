# Root gitignore for Sentinel

# Node / Frontend
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java / Maven
**/target/
**/.apt_generated
**/.classpath
**/.factorypath
**/.project
**/.settings/
**/.springBeans
**/.sts4-cache/
.mvn/wrapper/maven-wrapper.jar

# Python / ML
**/__pycache__/
*.py[cod]
*$py.class
**/.pytest_cache/
**/.venv/
**/venv/
**/env/

# Environment and sensitive keys
**/.env.local
**/.env.*.local

# IDEs & System
.vscode/
.idea/
*.DS_Store
Thumbs.db
