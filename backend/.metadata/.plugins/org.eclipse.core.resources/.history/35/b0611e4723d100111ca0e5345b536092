# src/main/resources/application.yml
spring:
  data:
    mongodb:
      uri: ${MONGODB_URI:mongodb://localhost:27017/sentinel}
      database: sentinel
  jackson:
    serialization:
      WRITE_DATES_AS_TIMESTAMPS: false

server:
  port: 8080

sentinel:
  ml:
    base-url: http://localhost:8000
    mode: RULES_ONLY # Options: RULES_ONLY, ML_ONLY, HYBRID
  jwt:
    secret: change_this_secret_to_32_chars_!!!!
    expiration-ms: 86400000

logging:
  level:
    root: INFO
    com.sentinel: DEBUG
