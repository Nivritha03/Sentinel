
spring:
  application:
    name: sentinel

  data:
    mongodb:
      uri: ${MONGODB_URI:mongodb://localhost:27017/sentinel}
      database: sentinel

  jackson:
    serialization:
      WRITE_DATES_AS_TIMESTAMPS: false

server:
  port: 8080

sentinel:
  ml:
    base-url: http://localhost:8000
    mode: RULES_ONLY # RULES_ONLY, ML_ONLY, HYBRID

  jwt:
    secret: ${JWT_SECRET:change_this_secret_to_32_chars_123456}
    expiration-ms: 86400000

logging:
  level:
    root: INFO
    com.sentinel: DEBUG
